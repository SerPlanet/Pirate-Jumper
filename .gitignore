# Unity .gitignore - Root of Unity Project
# Latest reference: https://github.com/github/gitignore/blob/main/Unity.gitignore

# -------------------------
# Unity Cache / Temp Folders
# -------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
.utmp/

# -------------------------
# Asset & Meta Files
# -------------------------
*.log
*.blend1
*.blend1.meta
sysinfo.txt
mono_crash.*

# -------------------------
# Editor / IDE / IDE Plugins
# -------------------------
.vs/
.gradle/
*.DotSettings.user
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# JetBrains Rider auto-generated plugins
/[Aa]ssets/Plugins/Editor/JetBrains*

# -------------------------
# Builds & Packages
# -------------------------
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
crashlytics-build.properties

# -------------------------
# Test Runner / Auto-generated Scenes
# -------------------------
InitTestScene*.unity*

# -------------------------
# Addressables
# -------------------------
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# -------------------------
# Visual Scripting Auto-Generated
# -------------------------
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta
